# Copy this file to api/.env and fill in real values.
# api/.env is gitignored; this example file IS committed.

# Native PostgreSQL 18 Windows service (NOT Docker - see PROGRESS.md 4.2)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@127.0.0.1:5432/traffic_trace

# Where the ingest worker writes vehicle crops (named by SHA-256)
EVIDENCE_DIR=../evidence

# Dashboard origin allowed through CORS during development
CORS_ORIGINS=http://localhost:3000

# API bind address. 0.0.0.0 is required so phones on the laptop's
# hotspot can reach POST /api/frames.
API_HOST=0.0.0.0
API_PORT=8000

# Guards match decisions and the demo reset
OFFICER_PIN=CHOOSE_A_PIN
